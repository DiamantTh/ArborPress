# syntax=docker/dockerfile:1
# ======================================================================
# ArborPress – Produktions-Image  (Ubuntu 24.04 LTS)
# Basis: ubuntu:24.04 mit CPython 3.14 aus einem Source-Build.
#
# Ubuntu 24.04 LTS (Noble) Standard-Support: April 2029
#                  ESM-Support:              April 2034
#
# Dieses Image ist DATENBANK-AGNOSTISCH.
# Es enthält beide Treiber (asyncpg für PostgreSQL und aiomysql für
# MariaDB) – welche Datenbank genutzt wird, entscheidet ausschliesslich
# die Umgebungsvariable ARBORPRESS_DB__URL zur Laufzeit.
# Die Compose-Datei setzt diesen Wert; das Image selbst weiss nichts
# von der Datenbankwahl.
#
# !! WICHTIGER HINWEIS – KEIN OS-WECHSEL IM BETRIEB !!
# -------------------------------------------------------
# Es existiert auch eine AlmaLinux-10-Variante (Containerfile.almalinux).
# Ein Wechsel des Basis-OS (AlmaLinux 10 ↔ Ubuntu) auf einer laufenden Instanz
# wird AUSDRÜCKLICH NICHT empfohlen:
#
# 1) INSTANCE-VOLUME: beide Varianten verwenden /srv/arborpress/instance,
#    die UID/GID-Zuordnung unterscheidet sich (Ubuntu 1001:1001, Alma 1001:0).
#
# 2) DATENBANKDATEN (kritisch!):
#    PostgreSQL-PGDATA und MariaDB-InnoDB-Tablespaces sind an die
#    libc/locale des jeweiligen Container-Images gebunden.
#    Ein roher Volume-Copy zwischen AlmaLinux und Ubuntu führt zu
#    Datenbankkorruption – auch bei identischer DB-Version.
#    Nicht getestet; verlasse dich NICHT darauf.
#
# SICHERER MIGRATIONSPFAD (immer, ohne Ausnahme):
#   PostgreSQL:  pg_dump -Fc  →  pg_restore
#   MariaDB:     mysqldump --single-transaction  →  mysql import
# ======================================================================

# ── Stage 1: Browser asset builder (Node is build-time only) ────────────
FROM node:24-bookworm-slim AS frontend-builder

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./frontend/
WORKDIR /build/frontend
RUN npm ci --no-audit --no-fund
WORKDIR /build
COPY frontend/ ./frontend/
COPY arborpress/static/ ./arborpress/static/
RUN npm run check --prefix frontend \
    && npm run build --prefix frontend \
    && npm run build:editor --prefix frontend

# ── Stage 2: Python builder ────────────────────────────────────────────
FROM ubuntu:24.04 AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# Build-Werkzeuge für C-Erweiterungen:
#   pillow (Bilder), cryptography, argon2-cffi
#   asyncpg und aiomysql bringen eigene C-Teile mit bzw. sind pure Python
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        build-essential \
        wget \
        xz-utils \
        libffi-dev \
        libssl-dev \
        libjpeg-dev \
        libpng-dev \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev \
        libreadline-dev \
        libsqlite3-dev \
        libgdbm-dev \
        uuid-dev \
    && rm -rf /var/lib/apt/lists/*

ARG PYTHON_VERSION=3.14.8
ARG POETRY_VERSION=2.5.1

# Build CPython because Ubuntu 24.04's system Python is below the project minimum.
RUN wget -O /tmp/Python.tgz "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz" \
    && tar -xzf /tmp/Python.tgz -C /tmp \
    && cd /tmp/Python-${PYTHON_VERSION} \
    && ./configure --prefix=/opt/python314 --with-ensurepip=install \
    && make -j"$(nproc)" \
    && make install \
    && /opt/python314/bin/python3.14 -m pip install --upgrade pip \
    && rm -rf /tmp/Python* \
    && /opt/python314/bin/python3.14 --version

# Poetry stays in its build-only environment; the application gets a separate venv.
RUN /opt/python314/bin/python3.14 -m venv /opt/poetry \
    && /opt/poetry/bin/python -m pip install --no-cache-dir "poetry==${POETRY_VERSION}" \
    && /opt/python314/bin/python3.14 -m venv /opt/venv
ENV VIRTUAL_ENV="/opt/venv" \
    PATH="/opt/poetry/bin:/opt/venv/bin:/opt/python314/bin:$PATH"

WORKDIR /build

# PIP_EXTRAS: Kommagetrennte Liste optionaler Extras die zusätzlich
# zu 'cache-redis' installiert werden, z. B. "sqlite" für SQLite-Support.
# Standardmäßig leer – Extras werden nur installiert wenn angegeben.
ARG PIP_EXTRAS=""

# Paket inkl. aller Abhängigkeiten installieren.
# cache-redis: optionaler Redis-Cache-Backend-Support.
COPY pyproject.toml poetry.lock README.md LICENSE ./
COPY arborpress/ ./arborpress/
COPY --from=frontend-builder /build/arborpress/static/dist/ ./arborpress/static/dist/
COPY --from=frontend-builder /build/arborpress/static/js/editor-adapters/tiptap.js ./arborpress/static/js/editor-adapters/tiptap.js
COPY --from=frontend-builder /build/arborpress/static/js/editor-adapters/tiptap.js.map ./arborpress/static/js/editor-adapters/tiptap.js.map
RUN set -eu; \
    set -- --only main --extras cache-redis; \
    set -f; \
    for extra in $(printf '%s' "$PIP_EXTRAS" | tr ',' ' '); do \
        set -- "$@" --extras "$extra"; \
    done; \
    set +f; \
    poetry install "$@" --no-root --no-interaction --no-ansi \
    && poetry build --format wheel \
    && /opt/venv/bin/python -m pip install --no-cache-dir --no-deps dist/*.whl

# ── Stage 3: Python-only runtime ──────────────────────────────────────
FROM ubuntu:24.04 AS runtime

LABEL org.opencontainers.image.title="ArborPress" \
      org.opencontainers.image.description="ArborPress Blog-Plattform (Ubuntu 24.04 LTS)" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.base.name="docker.io/library/ubuntu:24.04"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    PATH="/srv/arborpress/app/bin:/srv/arborpress/app/runtime/venv/bin:/srv/arborpress/app/runtime/python314/bin:$PATH" \
    # Host muss im Container auf 0.0.0.0 gebunden werden.
    ARBORPRESS_WEB__HOST="0.0.0.0" \
    ARBORPRESS_WEB__PORT="8066" \
    # 1 = ein vorgelagerter Reverse-Proxy (nginx/Traefik/Caddy).
    # 0 setzen, wenn ArborPress direkt erreichbar ist (kein Proxy).
    ARBORPRESS_WEB__TRUSTED_PROXIES="1" \
    ARBORPRESS_LOGGING__LEVEL="INFO" \
    ARBORPRESS_PREFIX="/srv/arborpress"

# Nur Laufzeit-Bibliotheken – keine Build-Werkzeuge im finalen Image
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libbz2-1.0 \
        libexpat1 \
        libffi8 \
        libgdbm-compat4t64 \
        libgdbm6t64 \
        libjpeg-turbo8 \
        liblzma5 \
        libncursesw6 \
        libpng16-16t64 \
        libreadline8t64 \
        libsqlite3-0 \
        libssl3t64 \
        netcat-openbsd \
        zlib1g \
        libuuid1 \
    && rm -rf /var/lib/apt/lists/* \
    # Nicht-privilegierten Benutzer anlegen (kein Login-Shell, kein Passwort)
    && groupadd -g 1001 arborpress \
    && useradd -u 1001 -g 1001 -s /sbin/nologin -M arborpress \
    # Ein expliziter Prefix mit ausschließlich persistentem Instance-State.
    && install -d -m 0700 -o arborpress -g arborpress \
        /srv/arborpress \
        /srv/arborpress/instance \
    && install -d -m 0755 /srv/arborpress/app/bin /srv/arborpress/app/runtime \
    && ln -s /opt/venv /srv/arborpress/app/runtime/venv \
    && ln -s /opt/python314 /srv/arborpress/app/runtime/python314 \
    && ln -s ../runtime/venv/bin/arborpress /srv/arborpress/app/bin/arborpress

# Deliberately unrelated to the ArborPress instance identity.
WORKDIR /

# Virtualenv aus Builder übernehmen
COPY --from=builder --chown=arborpress:arborpress /opt/venv /opt/venv
COPY --from=builder --chown=arborpress:arborpress /opt/python314 /opt/python314
RUN ! command -v node && ! command -v npm && ! command -v npx && ! command -v poetry

# Entrypoint-Skript
COPY --chown=arborpress:arborpress container/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Nicht-privilegierter Benutzer
USER arborpress

VOLUME ["/srv/arborpress/instance"]

EXPOSE 8066

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python3.14 -c \
        "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8066/_health')" \
        || exit 1

ENTRYPOINT ["/entrypoint.sh"]
