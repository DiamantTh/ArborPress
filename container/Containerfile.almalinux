# syntax=docker/dockerfile:1
# ======================================================================
# ArborPress – Produktions-Image  (AlmaLinux 10)
# Datei-Name: Containerfile.almalinux
#
# Ziel: Python 3.14 als Mindestlinie trotz fehlender AlmaLinux-Base-Images.
# Daher wird CPython 3.14 aus Source gebaut und in ein schlankes Runtime-
# Image auf AlmaLinux 10 uebernommen.
# ======================================================================

# ── Stage 1: Browser asset builder (Node is build-time only) ────────────
FROM docker.io/library/node:24-bookworm-slim AS frontend-builder

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./frontend/
WORKDIR /build/frontend
RUN npm ci --no-audit --no-fund
WORKDIR /build
COPY frontend/ ./frontend/
COPY arborpress/static/ ./arborpress/static/
RUN npm run check --prefix frontend \
    && npm run build --prefix frontend

# ── Stage 2: Python builder ────────────────────────────────────────────
FROM docker.io/library/almalinux:10 AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

ARG PYTHON_VERSION=3.14.8
ARG POETRY_VERSION=2.5.1

USER root

# Build-Werkzeuge für CPython + C-Erweiterungen (pillow/cryptography/argon2)
RUN dnf install -y \
        ca-certificates \
        gcc \
        make \
        wget \
        tar \
        xz \
        bzip2 \
        findutils \
        libffi-devel \
        openssl-devel \
        zlib-devel \
        xz-devel \
        bzip2-devel \
        readline-devel \
        sqlite-devel \
        gdbm-devel \
        libuuid-devel \
        libjpeg-turbo-devel \
        libpng-devel \
    && dnf clean all

# CPython 3.14 aus Source bauen
RUN wget -O /tmp/Python.tgz "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz" \
    && tar -xzf /tmp/Python.tgz -C /tmp \
    && cd /tmp/Python-${PYTHON_VERSION} \
    && ./configure --prefix=/opt/python314 --with-ensurepip=install \
    && make -j"$(nproc)" \
    && make install \
    && /opt/python314/bin/python3.14 -m pip install --upgrade pip \
    && rm -rf /tmp/Python* \
    && /opt/python314/bin/python3.14 --version

# Poetry stays in its build-only environment; the application gets a separate venv.
RUN /opt/python314/bin/python3.14 -m venv /opt/poetry \
    && /opt/poetry/bin/python -m pip install --no-cache-dir "poetry==${POETRY_VERSION}" \
    && /opt/python314/bin/python3.14 -m venv /opt/venv
ENV VIRTUAL_ENV="/opt/venv" \
    PATH="/opt/poetry/bin:/opt/venv/bin:/opt/python314/bin:$PATH"

WORKDIR /build

# Optional extras use the same comma-separated build argument as the Ubuntu image.
ARG PIP_EXTRAS=""

# Paket inkl. aller Abhängigkeiten installieren
COPY pyproject.toml poetry.lock README.md LICENSE ./
COPY arborpress/ ./arborpress/
COPY --from=frontend-builder /build/arborpress/static/dist/ ./arborpress/static/dist/
RUN set -eu; \
    set -- --only main --extras cache-redis; \
    set -f; \
    for extra in $(printf '%s' "$PIP_EXTRAS" | tr ',' ' '); do \
        set -- "$@" --extras "$extra"; \
    done; \
    set +f; \
    poetry install "$@" --no-root --no-interaction --no-ansi \
    && poetry build --format wheel \
    && /opt/venv/bin/python -m pip install --no-cache-dir --no-deps dist/*.whl

# ── Stage 3: Python-only runtime ──────────────────────────────────────
FROM docker.io/library/almalinux:10 AS runtime

LABEL org.opencontainers.image.title="ArborPress" \
      org.opencontainers.image.description="ArborPress Blog-Plattform (AlmaLinux 10)" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME="/home/arborpress" \
    PATH="/home/arborpress/arborpress/app/bin:/home/arborpress/arborpress/app/runtime/venv/bin:/home/arborpress/arborpress/app/runtime/python314/bin:$PATH" \
    ARBORPRESS_WEB__HOST="0.0.0.0" \
    ARBORPRESS_WEB__PORT="8066" \
    ARBORPRESS_WEB__TRUSTED_PROXIES="1" \
    ARBORPRESS_LOGGING__LEVEL="INFO" \
    ARBORPRESS_PREFIX="/home/arborpress/arborpress"

USER root

# Nur Laufzeit-Bibliotheken – keine Build-Werkzeuge im finalen Image
RUN dnf install -y \
        ca-certificates \
        openssl-libs \
        libffi \
        zlib \
        xz-libs \
        bzip2-libs \
        readline \
        sqlite-libs \
        libuuid \
        libjpeg-turbo \
        libpng \
        nmap-ncat \
        shadow-utils \
    && dnf clean all \
    && groupadd -g 1001 arborpress \
    && useradd -u 1001 -g 1001 -d /home/arborpress -s /sbin/nologin -M arborpress \
    && install -d -m 0700 -o arborpress -g arborpress \
        /home/arborpress \
        /home/arborpress/arborpress \
        /home/arborpress/arborpress/instance \
    && install -d -m 0755 /home/arborpress/arborpress/app/bin /home/arborpress/arborpress/app/runtime \
    && ln -s /opt/venv /home/arborpress/arborpress/app/runtime/venv \
    && ln -s /opt/python314 /home/arborpress/arborpress/app/runtime/python314 \
    && ln -s ../runtime/venv/bin/arborpress /home/arborpress/arborpress/app/bin/arborpress

# The process working directory is not an instance selector.
WORKDIR /

COPY --from=builder --chown=1001:1001 /opt/python314 /opt/python314
COPY --from=builder --chown=1001:1001 /opt/venv /opt/venv
RUN ! command -v node && ! command -v npm && ! command -v npx && ! command -v poetry

COPY --chown=1001:1001 container/entrypoint.sh /opt/app-root/entrypoint.sh
RUN chmod +x /opt/app-root/entrypoint.sh

USER arborpress

VOLUME ["/home/arborpress/arborpress/instance"]

EXPOSE 8066

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python3.14 -c \
        "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8066/_health')" \
        || exit 1

ENTRYPOINT ["/opt/app-root/entrypoint.sh"]
