# syntax=docker/dockerfile:1
# ======================================================================
# ArborPress – Produktions-Image  (AlmaLinux 10)
# Datei-Name: Containerfile.almalinux
#
# Ziel: Python 3.13 als Mindestlinie trotz fehlender UBI-3.13-Base-Images.
# Daher wird CPython 3.13 aus Source gebaut und in ein schlankes Runtime-
# Image auf AlmaLinux 10 uebernommen.
# ======================================================================

# ── Stage 1: Builder ───────────────────────────────────────────────────
FROM docker.io/library/almalinux:10 AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

ARG PYTHON_VERSION=3.13.14

USER root

# Build-Werkzeuge für CPython + C-Erweiterungen (pillow/cryptography/argon2)
RUN dnf install -y \
        ca-certificates \
        gcc \
        make \
        wget \
        tar \
        xz \
        bzip2 \
        findutils \
        libffi-devel \
        openssl-devel \
        zlib-devel \
        xz-devel \
        bzip2-devel \
        readline-devel \
        sqlite-devel \
        gdbm-devel \
        libuuid-devel \
        libjpeg-turbo-devel \
        libpng-devel \
    && dnf clean all

# CPython 3.13 aus Source bauen
RUN wget -O /tmp/Python.tgz "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz" \
    && tar -xzf /tmp/Python.tgz -C /tmp \
    && cd /tmp/Python-${PYTHON_VERSION} \
    && ./configure --prefix=/opt/python313 --with-ensurepip=install \
    && make -j"$(nproc)" \
    && make install \
    && /opt/python313/bin/python3.13 -m pip install --upgrade pip \
    && rm -rf /tmp/Python* \
    && /opt/python313/bin/python3.13 --version

# Isolierte Python-Umgebung (vom Runtime-Image getrennt)
RUN /opt/python313/bin/python3.13 -m venv /opt/venv
ENV PATH="/opt/venv/bin:/opt/python313/bin:$PATH"

WORKDIR /build

# Paket inkl. aller Abhängigkeiten installieren
COPY pyproject.toml ./
COPY README.md ./
COPY arborpress/ ./arborpress/
RUN pip install --no-cache-dir ".[cache-redis]"

# ── Stage 2: Runtime ───────────────────────────────────────────────────
FROM docker.io/library/almalinux:10 AS runtime

LABEL org.opencontainers.image.title="ArborPress" \
      org.opencontainers.image.description="ArborPress Blog-Plattform (AlmaLinux 10)" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:/opt/python313/bin:$PATH" \
    ARBORPRESS_WEB__HOST="0.0.0.0" \
    ARBORPRESS_WEB__PORT="8066" \
    ARBORPRESS_WEB__TRUSTED_PROXIES="1" \
    ARBORPRESS_LOGGING__LEVEL="INFO"

USER root

# Nur Laufzeit-Bibliotheken – keine Build-Werkzeuge im finalen Image
RUN dnf install -y \
        ca-certificates \
        openssl-libs \
        libffi \
        zlib \
        xz-libs \
        bzip2-libs \
        readline \
        sqlite-libs \
        libuuid \
        libjpeg-turbo \
        libpng \
        nmap-ncat \
    && dnf clean all \
    && install -d -m 0775 -o 1001 -g 0 \
        /opt/app-root/src/media \
        /opt/app-root/src/logs \
    && chown -R 1001:0 /opt/app-root \
    && chmod -R g=u /opt/app-root

WORKDIR /opt/app-root/src

COPY --from=builder --chown=1001:0 /opt/python313 /opt/python313
COPY --from=builder --chown=1001:0 /opt/venv /opt/venv

COPY --chown=1001:0 container/entrypoint.sh /opt/app-root/entrypoint.sh
RUN chmod +x /opt/app-root/entrypoint.sh

USER 1001

VOLUME ["/opt/app-root/src/media", "/opt/app-root/src/logs"]

EXPOSE 8066

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python3.13 -c \
        "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8066/_health')" \
        || exit 1

ENTRYPOINT ["/opt/app-root/entrypoint.sh"]
