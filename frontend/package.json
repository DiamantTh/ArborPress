{
  "name": "arborpress-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "dev": "vite",
    "dev:watch": "vite build --watch",
    "build": "vite build",
    "build:editor": "vite build --config vite.config.editor.js",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^9.0.0",
    "@tiptap/core": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "svelte": "^4.2.8",
    "svelte-check": "^3.8.6",
    "tslib": "^2.4.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  },
  "type": "module"
}
